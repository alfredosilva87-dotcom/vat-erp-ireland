# HTTPS front door for the office server.
#
# Why a proxy at all: the session cookie is issued with the `Secure` flag, and
# browsers refuse Secure cookies over plain http:// on anything that is not
# localhost. Without real TLS, everyone outside this machine gets a login screen
# that silently loops. TLS here fixes that without weakening the cookie.
#
# `tls internal` makes Caddy run its own certificate authority and issue (and
# auto-renew) a certificate for $SERVER_HOST. Each workstation has to trust that
# CA once — see SERVIDOR.md, "Confiar no certificado". No internet, no external
# CA, nothing leaves the building.

{
	# No ACME account, no outbound calls: this server is not on the internet.
	admin off
	auto_https disable_redirects

	# Browsers do not send SNI when the address is a bare IP, and without SNI
	# Caddy cannot pick a certificate — the handshake dies with "tlsv1 alert
	# internal error" and the page simply never loads. Since a small office is
	# most likely to reach this server by IP, tell Caddy which certificate to
	# serve when the client asks for nothing in particular.
	default_sni {$SERVER_HOST}
}

# The site covers the NAME and the machine's IP addresses, and that second part
# matters more than it looks.
#
# With only the name in the certificate, a station browsing by IP still gets a
# handshake (default_sni above hands it the name's certificate) but the browser
# then compares the address it typed against the names in the certificate, finds
# no match, and says "not secure" — even on a station that already trusts the
# internal CA. Installing the CA fixes "unknown authority"; it cannot fix "wrong
# name".
#
# So the IP goes IN the certificate, as a SAN. Caddy's internal CA issues IP SANs
# natively. SERVER_IPS is filled by the installer with every LAN address it finds,
# space-separated (the same separator Caddy uses between site addresses); it is
# empty when the machine has none, which the parser tolerates.
{$SERVER_HOST} {$SERVER_IPS} {
	tls internal

	encode zstd gzip

	# Only GoTrue is reachable from the network, and only because the
	# password-recovery screen parses the e-mail link in the browser and needs
	# to exchange it for a session (app/reset-password/page.tsx).
	#
	# Everything else in Kong — the REST API, Storage, and Supabase Studio —
	# deliberately stays off the LAN. The Next.js server reaches those over the
	# Docker network, so nothing here needs to.
	handle /auth/v1/* {
		reverse_proxy kong:8000
	}

	handle {
		reverse_proxy app:3000
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}

# Anyone who types the bare http:// address gets sent to https://, so a
# mistyped address is not mistaken for the app being down.
#
# The target is the full public origin, not just the host: when the proxy is
# not on 443, redirecting to `https://host` alone would send people to a port
# nothing is listening on.
http://{$SERVER_HOST} {
	redir {$PUBLIC_ORIGIN}{uri} permanent
}
