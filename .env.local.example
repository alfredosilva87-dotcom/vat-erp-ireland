# --- Supabase (optional to start) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Reading engine (Google Gemini free tier) ---
# Get a free key at https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest

# --- Entrada por e-mail (camada B2, opcional) ---
# O servidor BUSCA numa caixa do escritório por IMAP; ele não recebe e-mail.
# Rodando na rede local sem exposição à internet, receber SMTP exigiria abrir
# porta e publicar MX apontando para dentro — buscar não abre nada.
#
# A senha fica AQUI e nunca no banco: um despejo do banco não pode carregar a
# senha do e-mail do escritório junto com as notas.
#
# Gmail / Google Workspace e Microsoft 365 exigem SENHA DE APLICATIVO, não a
# senha da conta.
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=notas@seuescritorio.ie
MAIL_IMAP_PASSWORD=senha-de-aplicativo
MAIL_IMAP_MAILBOX=INBOX
# O endereço base da caixa. O sistema mostra `notas+token@...` para cada cliente,
# usando sub-endereçamento, e o token é gerado por cliente e por direção.
MAIL_INBOX_ADDRESS=notas@seuescritorio.ie
# Só desligue TLS em servidor de teste na própria máquina. O padrão é TLS.
# MAIL_IMAP_SECURE=false
