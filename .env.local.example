# --- Supabase (optional to start) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Reading engine (Google Gemini free tier) ---
# Get a free key at https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest

# --- Entrada por e-mail (camada B2, opcional) ---
# O servidor BUSCA numa caixa do escritório por IMAP; ele não recebe e-mail.
# Rodando na rede local sem exposição à internet, receber SMTP exigiria abrir
# porta e publicar MX apontando para dentro — buscar não abre nada.
#
# A senha fica AQUI e nunca no banco: um despejo do banco não pode carregar a
# senha do e-mail do escritório junto com as notas.
#
# Gmail / Google Workspace e Microsoft 365 exigem SENHA DE APLICATIVO, não a
# senha da conta.
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=notas@seuescritorio.ie
MAIL_IMAP_PASSWORD=senha-de-aplicativo
MAIL_IMAP_MAILBOX=INBOX
# O endereço base da caixa. O sistema mostra `notas+token@...` para cada cliente,
# usando sub-endereçamento, e o token é gerado por cliente e por direção.
MAIL_INBOX_ADDRESS=notas@seuescritorio.ie
# Só desligue TLS em servidor de teste na própria máquina. O padrão é TLS.
# MAIL_IMAP_SECURE=false

# --- Entrada por telefone (camada B4, opcional) ---
# O cliente do escritório fotografa a nota no posto e ela chega na fila. O
# telefone está no 4G e este servidor é da rede local, então a captura mora numa
# PASSAGEM na nuvem: um projeto Supabase SEPARADO, que guarda a foto até este
# servidor buscar e apagar. É a única coisa aqui que aponta para fora, e só para
# fora — nada entra por esta variável.
#
# Projeto SEPARADO do que o cliente usa para teste: esta passagem recebe nota
# fiscal de verdade. Aplique selfhost/schema/relay/001_relay.sql nele.
#
# As MESMAS duas variáveis vão também no projeto da Vercel que serve a tela de
# captura, apontando para o mesmo lugar.
RELAY_SUPABASE_URL=https://SEU-PROJETO-PASSAGEM.supabase.co
RELAY_SUPABASE_SERVICE_ROLE_KEY=a-service-role-key-da-passagem
# Onde a tela de captura esta publicada. Sem isto o Cadastro mostra so o token,
# que sozinho nao serve para nada — o contador precisa do link inteiro.
PHONE_CAPTURE_URL=https://vat-erp-captura.vercel.app
